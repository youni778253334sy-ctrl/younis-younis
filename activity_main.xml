<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/white">

    <TextView
        android:id="@+id/welcome_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/welcome"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_modems"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/modem_management"
        android:layout_marginBottom="12dp"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btn_switches"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/switch_management"
        android:layout_marginBottom="12dp"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btn_outages"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/outage_management"
        android:layout_marginBottom="12dp"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btn_users"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/user_management"
        android:textSize="16sp" />

</LinearLayout>
